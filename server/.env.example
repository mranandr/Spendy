# Server
PORT=5050
CORS_ORIGINS=*

# Postgres (Supabase service role — data only, never ship to client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT — generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters-long
JWT_ISSUER=spendy-api
JWT_AUDIENCE=spendy-client
JWT_ACCESS_TOKEN_MINUTES=15

# Google OAuth 2.0 (Google Cloud Console → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated allowed redirect URIs (must match client exactly)
OAUTH_REDIRECT_URIS=http://localhost:8082/auth/callback,exp://192.168.90.111:8082/--/auth/callback,spendy://auth/callback

# Broker token encryption at rest (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
BROKER_TOKEN_ENCRYPTION_KEY=

# Zerodha Kite Connect
KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=spendy://zerodha

# Groww Trade API (server-side; optional if users paste access tokens)
GROWW_API_KEY=
GROWW_API_SECRET=

# AI — at least one provider
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AI_CLAUDE_MODEL=anthropic/claude-sonnet-4
AI_GEMINI_MODEL=google/gemini-2.0-flash

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_AI_PER_HOUR=20
RATE_LIMIT_BROKER_SYNC_PER_HOUR=30
